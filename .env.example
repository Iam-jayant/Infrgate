# =============================================================================
# InfrGate — Environment Variables
# =============================================================================
# Copy this file to .env and fill in your values.
# Never commit .env to version control.
# =============================================================================

# --- Database (PostgreSQL) ---------------------------------------------------
DATABASE_URL=postgresql+asyncpg://infrgate:infrgate@localhost:5432/infrgate

# --- Redis --------------------------------------------------------------------
REDIS_URL=redis://localhost:6379/0

# --- Provider Keys ------------------------------------------------------------
# Required: Get a free key from https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key-here

# --- Admin Authentication -----------------------------------------------------
# Secret key for admin API access. Generate a strong random string.
ADMIN_API_KEY=your-admin-api-key-here

# --- Server -------------------------------------------------------------------
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO

# --- Rate Limiting (defaults) ------------------------------------------------
DEFAULT_RPM=60
DEFAULT_TPM=100000
